# STILLGELEGT seit 2026-08-10 — der Depot-Teil liegt bei DepotPi.
# Der Timer ist per `systemctl disable --now` aus; zusaetzlich steigt das Skript
# selbst sofort aus (src/common/depot_stillgelegt.py). Datei bleibt als Referenz.
[Unit]
Description=Invest-Pi · DCA Watchdog taeglich 18:00 CEST (nach Market Close)

[Timer]
OnCalendar=*-*-* 18:00:00
Persistent=true

[Install]
WantedBy=timers.target
